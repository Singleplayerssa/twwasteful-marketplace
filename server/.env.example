PORT=4000
NODE_ENV=development
# For local/ serverless-friendly Supabase connection, use Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@POOLER_HOST:6543/postgres
PGSSL=true
PG_POOL_MAX=1
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_this_value
SUPABASE_STORAGE_BUCKET=twwasteful-materials
# Optional: creates a dedicated admin company and account if the email does not exist.
ADMIN_NAME=Administrator T'wwasteful
ADMIN_EMAIL=
ADMIN_PASSWORD=
